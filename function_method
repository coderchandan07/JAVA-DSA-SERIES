//    Binary to Decimal
   
   public static void BinToDec(long binNum) {
       long myNum = binNum;
       long pow = 0;
       long decNum = 0;

       while (binNum > 0) {
           long lastdigit = binNum % 10;
           decNum = decNum + (lastdigit * (long) Math.pow(2, pow));

           pow++;
           binNum = binNum / 10;
       }
       System.out.println("Decimal of " + myNum + " = " + decNum);
   }

   public static void main(String args[]) {
       BinToDec(111);
   }

