//   Find Binomial Coefficient
//    formula fact_n/(fact_r*factn-r)

   public static long factorial(long n ){
       long fact = 1;
       for(long i=1; i<=n; i++){
          fact = fact*i;
       }
       return fact;
   }
   public static long binoCoeff(long n, long r){
       long fact_n = factorial(n);
       long fact_r = factorial(r);
       long fact_nmr = factorial(n-r);

       long binoCoeff = fact_n/(fact_r*fact_nmr);
       return binoCoeff;
   }
   public static void main(){
       Scanner sc = new Scanner(System.in);
       System.out.println("Enter n: ");
       long n = sc.nextLong();
       System.out.println("Enter r: ");
       long r = sc.nextLong();
       long binoCoeff = binoCoeff(n ,r);
       System.out.println("Binomial Coefficient is: "+binoCoeff);
   }

