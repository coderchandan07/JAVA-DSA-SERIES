//    Decimal to Binary converter

   public static void DecToBin(long num){
       long myNum = num;
       long pow = 0;
       long binNum = 0;

       while(num > 0){
         long rem = num % 2;
         binNum = binNum + (rem * (long)Math.pow(10,pow));

         pow++;
         num = num /2;
       }
       System.out.println("Decimal of " + myNum + " = " +binNum);
   }
   public static void main(String args[]){
       DecToBin(11);
   }

